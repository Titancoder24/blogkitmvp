{
  "name": "@blogkit/remix",
  "version": "0.0.0",
  "description": "Remix (v2+) adapter for BlogKit. Mounts /admin, /blog, /sitemap.xml, /rss.xml, /atom.xml, /llms.txt, /robots.txt, /api/mcp.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blogkit/admin": "workspace:*",
    "@blogkit/core": "workspace:*",
    "@blogkit/mcp": "workspace:*",
    "@blogkit/seo": "workspace:*",
    "@blogkit/supabase": "workspace:*"
  },
  "peerDependencies": {
    "@remix-run/node": ">=2",
    "@remix-run/react": ">=2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
