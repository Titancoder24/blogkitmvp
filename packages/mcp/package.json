{
  "name": "@blogkit/mcp",
  "version": "0.0.0",
  "description": "BlogKit MCP server (stdio + HTTP/SSE). Exposes content CRUD, taxonomy, media, SEO reports, template introspection, and theme tools as MCP tools (PRD §9).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blogkit/core": "workspace:*",
    "@blogkit/intelligence": "workspace:*",
    "@blogkit/scoring": "workspace:*",
    "@blogkit/seo": "workspace:*",
    "@blogkit/supabase": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
