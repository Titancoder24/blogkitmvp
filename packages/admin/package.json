{
  "name": "@blogkit/admin",
  "version": "0.0.0",
  "description": "BlogKit admin app — auth, post list, resume-builder-style editor, media library, live AI Visibility scoring panel, theme/template pickers (PRD §5, §5A, §5B).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blogkit/core": "workspace:*",
    "@blogkit/editor": "workspace:*",
    "@blogkit/seo": "workspace:*",
    "@blogkit/supabase": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
